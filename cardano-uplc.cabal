cabal-version:   3.0
name:            cardano-uplc
version:         0.1.0
synopsis:        Untyped Plutus Core syntax, flat codec and CEK evaluator
description:
  A Haskell implementation of Untyped Plutus Core, the language that every
  Cardano smart contract compiles to. This package provides the abstract
  syntax, the flat binary codec scripts are stored in on chain, and a CEK
  machine that runs the core terms and the integer, bytestring and bitwise
  builtins; the other builtins follow in later releases.
  Where the Plutus specification and plutus-core differ, the package follows
  plutus-core, which the network runs. The tests include the official
  conformance cases for what the machine implements.

license:         MIT
license-file:    LICENSE
author:          sandykwl <lambdac.dev01@gmail.com>
maintainer:      sandykwl <lambdac.dev01@gmail.com>
category:        Language
extra-doc-files:
  CHANGELOG.md
  LICENSE-APACHE
  NOTICE
  README.md

extra-source-files:
  test/conformance/**/*.flat
  test/conformance/**/*.flat.expected
  test/conformance/LICENSE
  test/conformance/NOTICE
  test/conformance/SOURCE.md

tested-with:     GHC ==9.6.7 || ==9.8.4

source-repository head
  type:     git
  location: https://github.com/sandykwl/cardano-uplc

common lang
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    NoDeriveDataTypeable
    NoMonomorphismRestriction
    NoPostfixOperators
    NoStarIsType

  build-depends:      base >=4.18 && <4.20
  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wincomplete-uni-patterns
    -Wincomplete-record-updates -Wmissing-export-lists
    -Wmissing-deriving-strategies -Wpartial-fields -Wunused-packages

library
  import:          lang
  hs-source-dirs:  src
  exposed-modules:
    Cardano.UPLC.Builtin
    Cardano.UPLC.Constant
    Cardano.UPLC.Data
    Cardano.UPLC.Data.Cbor
    Cardano.UPLC.Flat
    Cardano.UPLC.Machine
    Cardano.UPLC.Name
    Cardano.UPLC.Term
    Cardano.UPLC.Ty
    Cardano.UPLC.Value

  -- The codec's bit layer and error types. Cardano.UPLC.Flat re-exports the
  -- errors, and nothing outside the package needs the bit layer. The CBOR
  -- internals hold the reader the flat codec uses for data constants. The
  -- machine's values and builtins have no use outside Cardano.UPLC.Machine,
  -- which re-exports the semantics variants.
  other-modules:
    Cardano.UPLC.Data.Cbor.Internal
    Cardano.UPLC.Flat.Bits
    Cardano.UPLC.Flat.Error
    Cardano.UPLC.Machine.Builtins
    Cardano.UPLC.Machine.Builtins.Bitwise
    Cardano.UPLC.Machine.Builtins.ByteString
    Cardano.UPLC.Machine.Builtins.Error
    Cardano.UPLC.Machine.Builtins.Integer
    Cardano.UPLC.Machine.CekValue

  build-depends:
      , bytestring   >=0.11   && <0.13
      , cborg        >=0.2.10 && <0.3
      , containers   >=0.6    && <0.8
      , text         >=2.0    && <2.2
      , transformers >=0.6    && <0.7
      , vector       >=0.13.2 && <0.14

test-suite tests
  import:         lang
  type:           exitcode-stdio-1.0
  main-is:        Test.hs
  hs-source-dirs: test
  other-modules:
    Builtins.Bitwise
    Builtins.ByteString
    Builtins.Integer
    Cardano.UPLC.Test.Gen
    Conformance
    DataCbor
    Machine
    ValueFlat
  build-depends:
    , bytestring
    , cardano-uplc
    , containers
    , directory
    , filepath
    , QuickCheck        >=2.14 && <2.16
    , tasty             >=1.5  && <1.6
    , tasty-hunit       >=0.10 && <0.11
    , tasty-quickcheck  >=0.10 && <0.12
    , text
    , vector
